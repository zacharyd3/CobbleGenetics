	quest.36EAFD803A8560EF.quest_subtitle: "Purify a Shadow Pokémon"
	quest.36EAFD803A8560EF.quest_desc: ["At 0% corruption the heart opens: big friendship and stability boosts, half its genetic damage repaired - and sometimes a &6purification-exclusive mutation&r that no breeding can produce."]
