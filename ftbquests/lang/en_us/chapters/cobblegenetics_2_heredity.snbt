{
	quest.15C95900440E45BD.title: "The Genetic Incubator"
	quest.15C95900440E45BD.quest_subtitle: "Breeding, CobbleGenetics style"
	quest.15C95900440E45BD.quest_desc: ["Place the &bGenetic Incubator&r, right-click it and pick two party Pokémon (level 15+). Then right-click it with a &aberry&r for each of them: love hearts, and breeding begins." "" "Same family: main-game rules (a shared &eegg group&r and opposite genders, or &dDitto&r). Two &ddifferent&r families make a &dfusion baby&r if Fusionmon is installed!" "" "After a few minutes they come back to your party and an &aEgg&r waits inside: right-click to take it."]
	quest.4C3CACB8E8D2B19A.title: "New Generation"
	quest.4C3CACB8E8D2B19A.quest_subtitle: "Breed two Pokémon"
	quest.4C3CACB8E8D2B19A.quest_desc: ["Keep the &aPokémon Egg&r in your inventory and &ewalk&r: it hatches into a level 1 Pokémon. Its tooltip hints how close it is, and a party Pokémon with &6Flame Body&r or &6Magma Armor&r halves the walk." "" "Its genes are &oa mix&r of both parents plus some randomness - never a copy of either. Three of its stats (IVs) also come from a random parent."]
	quest.2E3352B9C0D17B99.title: "Proud Parent"
	quest.2E3352B9C0D17B99.quest_subtitle: "Analyse one of the parents"
	quest.2E3352B9C0D17B99.quest_desc: ["Analyse one of the parents again and keep its numbers in mind (or &bRecord&r it)."]
	quest.7DB8930071B094AE.title: "Family Resemblance"
	quest.7DB8930071B094AE.quest_subtitle: "Analyse the offspring"
	quest.7DB8930071B094AE.quest_desc: ["Now analyse the offspring. Its potential and stability sit between its parents', and its &bOrigin&r shows its generation." "" "Use the &bHeredity Module&r to reach research level 3 and see &dInherited Traits&r."]
	quest.623898E7FF8509CB.title: "It Runs in the Family"
	quest.623898E7FF8509CB.quest_subtitle: "Identify an inherited trait"
	quest.623898E7FF8509CB.quest_desc: ["At research level 3, analyse a bred Pokémon and read its &dInherited Traits&r." "" "Each trait has two copies (alleles), one from each parent. A &orecessive&r allele only shows when a Pokémon carries two copies - so rare traits can hide for generations and reappear."]
	quest.129462637227545C.title: "Skipped a Generation"
	quest.129462637227545C.quest_subtitle: "Breed out a rare recessive trait"
	quest.129462637227545C.quest_desc: ["Breed an offspring that expresses a &6rare recessive&r trait (highlighted in gold), such as &eShadowproof&r or &eLustrous&r." "" "Tip: at research level 4 the Analyzer shows the hidden allele pairs, and analysing two Pokémon one after the other predicts what their offspring could get."]
	quest.2530A0BFCA34A198.title: "Research Level 3"
	quest.2530A0BFCA34A198.quest_subtitle: "Heredity"
	quest.2530A0BFCA34A198.quest_desc: ["Level 3 adds &bMutation Susceptibility&r, size genes and inherited traits." "" "Your next step: the &5Shadow Research&r chapter."]
}
